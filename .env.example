# .env.example — committed to git, contains NO real values.
#
# Setup:
# 1. Copy this file to .env in this same folder:
#      cp .env.example .env
# 2. Edit .env and fill in your real values.
# 3. .env is listed in .gitignore and will never be committed.

CANISTER_ID=your-canister-id-here
HOST=http://localhost:8000
SECRET_KEY=your-secret-key-here
